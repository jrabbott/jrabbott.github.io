---
import PageLayout from '../../layouts/PageLayout.astro';
import { reading, readingTopics } from '../../data/reading';
import { documentTitle } from '../../lib/documentTitle';
---

<PageLayout
  title={documentTitle('Reading')}
  description="Books I’ve read and would recommend. Summaries, titles, and authors."
>
  <section class="reading" data-pagefind-body>
    <h1>Reading</h1>
    <p class="muted">Books I’ve read and would recommend.</p>

    <div class="reading-filter" hidden data-reading-filter data-pagefind-ignore>
      <div class="reading-filter__controls" role="group" aria-label="Filter by topic">
        <button type="button" class="reading-filter__button" data-topic="all" aria-pressed="true">
          All
        </button>
        {readingTopics.map((topic) => (
          <>
            <span class="reading-filter__sep muted" aria-hidden="true">
              {' '}
              ·{' '}
            </span>
            <button
              type="button"
              class="reading-filter__button"
              data-topic={topic}
              aria-pressed="false"
            >
              {topic}
            </button>
          </>
        ))}
      </div>
      <p class="reading-filter__status muted" data-reading-filter-status aria-live="polite"></p>
    </div>

    <div class="reading-list" data-reading-list>
      {reading.map((book) => (
        <article class="book" id={book.id} data-topics={book.topics.join(' ')}>
          <h2>{book.title}</h2>
          <p class="book__authors muted">{book.authors}</p>
          <p class="book__topics muted">{book.topics.join(' · ')}</p>
          <p>{book.summary}</p>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<script>
  import { initReadingFilter } from '../../scripts/readingFilter';

  initReadingFilter();
</script>

<style>
  .reading {
    max-width: 44rem;
  }

  .reading h1 {
    margin-bottom: var(--space-3);
  }

  .reading-filter {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .reading-filter__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .reading-filter__button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    text-decoration: none;
  }

  .reading-filter__button:hover {
    color: var(--color-accent);
  }

  .reading-filter__button[aria-pressed='true'] {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .reading-filter__status {
    margin: var(--space-3) 0 0;
    font-size: 0.95rem;
    min-height: 1.4em;
  }

  .reading-list {
    margin-top: var(--space-2);
  }

  .book {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: var(--space-4);
  }

  .book h2 {
    text-transform: none;
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .book__authors {
    margin-bottom: var(--space-2);
  }

  .book__topics {
    margin-bottom: var(--space-4);
    font-size: 0.95rem;
  }
</style>
