---
import PageLayout from '../../layouts/PageLayout.astro';
import { groupReadingByTopic, topicAnchor } from '../../data/reading';
import { documentTitle } from '../../lib/documentTitle';

const grouped = groupReadingByTopic();
---

<PageLayout
  title={documentTitle('Reading')}
  description="Books I’ve read and would recommend. Summaries, titles, and authors."
>
  <section class="reading" data-pagefind-body>
    <h1>Reading</h1>
    <p class="muted">Books I’ve read and would recommend.</p>

    <nav class="reading-topics" aria-label="Reading topics">
      {grouped.map(({ topic }, index) => (
        <>
          {index > 0 && (
            <span class="reading-topics__sep muted" aria-hidden="true">
              {' '}
              ·{' '}
            </span>
          )}
          <a href={`#${topicAnchor(topic)}`}>{topic}</a>
        </>
      ))}
    </nav>

    {grouped.map(({ topic, books }) => (
      <section class="reading-group" aria-labelledby={topicAnchor(topic)}>
        <h2 id={topicAnchor(topic)}>{topic}</h2>
        {books.map((book) => (
          <article class="book" id={book.topics[0] === topic ? book.id : undefined}>
            <h3>{book.title}</h3>
            <p class="book__authors muted">{book.authors}</p>
            <p class="book__topics muted">{book.topics.join(' · ')}</p>
            <p>{book.summary}</p>
          </article>
        ))}
      </section>
    ))}
  </section>
</PageLayout>

<style>
  .reading {
    max-width: 44rem;
  }

  .reading h1 {
    margin-bottom: var(--space-3);
  }

  .reading-topics {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .reading-topics a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .reading-topics a:hover {
    color: var(--color-accent);
  }

  .reading-group {
    margin-top: var(--space-7);
  }

  .reading-group > h2 {
    margin-bottom: var(--space-2);
    scroll-margin-top: var(--space-4);
  }

  .book {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: var(--space-4);
  }

  .book h3 {
    text-transform: none;
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .book__authors {
    margin-bottom: var(--space-2);
  }

  .book__topics {
    margin-bottom: var(--space-4);
    font-size: 0.95rem;
  }
</style>
