---
import PageLayout from '../../layouts/PageLayout.astro';
import { projectHref } from '../../data/projects';
import { documentTitle } from '../../lib/documentTitle';

const milestones = [
  {
    title: 'Principal Consultant / Engineer, Hippo Digital',
    dates: 'Aug 2020 – Present',
    location: 'Leeds',
    tech: 'C#, .NET Core, ASP.NET Core, Azure, SQL Server, Cosmos DB, React, Terraform/Bicep',
    paragraphs: [
      'I lead technical direction for teams building digital services for public-sector clients. Some days that’s architecture. Some days I’m in the code. A lot of the time it’s helping the team move quickly without making a mess.',
      'On DfE work I’ve set the technical direction for complex platforms, built shared patterns other teams could reuse, and stood up Azure environments with infrastructure as code. I’ve pushed for better CI/CD, observability, and automated testing — and I’ve brought AI-assisted tooling in where it actually helps people ship.',
      'I work closely with Product and Delivery. We shape the roadmap, challenge shaky assumptions, and keep the tech tied to something users actually need. Mentoring is a big part of it too. I want teams that still hold together after I’ve moved on.',
    ],
    engagements: [
      {
        name: 'Digital Assessment Service (RBA)',
        client: 'DfE · Standards and Testing Agency',
        dates: '2020 – 2023',
        href: projectHref('digital-assessment-service'),
        summary:
          'Started as Senior Developer, later Technical Lead. IVT and TPT only — not live. IVT ~1,502 pupils / ~9.2GB. TPT ~300 schools (~3,000 pupils, two-week September window) / ~30GB. Live (~800,000 in Sept 2023) and ~5.2TB/year with IVT, TPT and Live in parallel were the programme scale those phases prepared for.',
      },
      {
        name: 'Financial Benchmarking and Insights Tool',
        client: 'DfE',
        dates: '2023 – 2026',
        href: projectHref('education-benchmarking-and-insights'),
        summary:
          'I led the build of a data platform and portal so schools can manage financial data, compare with peers, and spot better ways to plan.',
      },
      {
        name: 'Accessing Childcare Entitlement Checker',
        client: 'DfE',
        dates: '2026',
        href: projectHref('accessing-childcare-entitlement-checker'),
        summary:
          'I led the architecture and delivery of a service that helps parents and carers check eligibility for funded childcare and Tax-Free Childcare.',
      },
    ],
  },
  {
    title: 'Development Lead, Collision Management Systems',
    dates: 'Mar 2020 – Jul 2020',
    tech: '.NET Core, Azure, REST APIs, SQL Server, NUnit',
    paragraphs: [
      'I led development on a cloud-native data platform. I made the technical calls, improved unit, integration, and API testing, and helped the team get more predictable about releases. I also spent plenty of time pairing and unblocking the hard stuff.',
    ],
  },
  {
    title: 'Application Developer, JPP Consulting',
    dates: 'Oct 2018 – Mar 2020',
    tech: 'C#, .NET Core, EF Core, Web API, AutoCAD/Revit APIs, NUnit',
    paragraphs: [
      'I built internal business apps and workflow automation, including AutoCAD and Revit integrations that cut out manual work. Most projects ran end-to-end: understand the process, build the thing, work with senior stakeholders to get it live.',
    ],
  },
  {
    title: 'Product Development Engineer / Technical Lead, CSols',
    dates: 'Oct 2013 – Oct 2018',
    tech: 'C#, VB.NET, SQL Server, Oracle, Web API, TeamCity, NUnit',
    paragraphs: [
      'I led a team building laboratory information systems in regulated environments. Over five years I brought in CI/CD, automated testing, and clearer engineering standards. Quality and delivery both got better for it.',
      'I also did pre-sales — demos, RFP responses, technical talks — and mentored engineers across the team. It’s where I learned how to balance product pressure, regulated quality, and just shipping the software.',
    ],
  },
  {
    title: 'Earlier career',
    dates: '2003 – 2013',
    paragraphs: [
      'Business Analyst, Product Specialist, and Analyst/Programmer roles across Medacs Healthcare, Capita, and Heidelberg Cement. Those years taught me requirements, testing, and delivery — and left me with a strong preference for knowing what success looks like before anyone starts building.',
    ],
  },
];
---

<PageLayout
  title={documentTitle('Career')}
  description="Career summary, role milestones, and how I approach the work after 15+ years of delivery."
>
  <section class="career">
    <h1>Career History</h1>
    <p class="muted">Roles, milestones, and how I approach the work.</p>

    <section class="career-block" aria-labelledby="career-summary">
      <h2 id="career-summary">Career Summary</h2>
      <p>
        I’m an engineering leader and technical architect. I’ve spent 15+ years building cloud
        platforms across public sector, SaaS, and regulated environments — mostly .NET and Azure,
        with a focus on distributed systems, platform engineering, and modern DevOps.
      </p>
      <p>
        I still write code. I also set direction, improve how teams work, and care a lot about
        automation, quality, and platforms that don’t fall over. Outside client work I’m involved in
        the regional community through YAUG and the Northern DevOps &amp; Platform Conference. The
        same habit of sharing what I’ve learned shows up in the teams I lead.
      </p>
    </section>

    <section class="career-block" aria-labelledby="career-milestones">
      <h2 id="career-milestones">Key Career Milestones</h2>

      {
        milestones.map((milestone) => (
          <article class="milestone">
            <h3>{milestone.title}</h3>
            <p class="milestone__meta muted">
              {milestone.dates}
              {milestone.location ? ` · ${milestone.location}` : ''}
            </p>
            {milestone.tech && <p class="milestone__tech">{milestone.tech}</p>}
            {milestone.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {milestone.engagements && (
              <div class="engagements">
                <h4>Selected engagements</h4>
                <ul class="engagements__list">
                  {milestone.engagements.map((engagement) => (
                    <li class="engagement">
                      <p class="engagement__title">
                        <a href={engagement.href}>{engagement.name}</a>
                      </p>
                      <p class="engagement__meta muted">
                        {engagement.client} · {engagement.dates}
                      </p>
                      <p>{engagement.summary}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </section>

    <section class="career-block" aria-labelledby="career-philosophy">
      <h2 id="career-philosophy">Professional Philosophy</h2>
      <p>
        I care about systems that hold up in production, and teams that can keep improving them.
        Clear goals. Honest feedback. Less theatre.
      </p>
      <p>
        I push for clarity on what success looks like early, then hold that line through
        architecture, delivery, and operations. Leadership, for me, is creating the conditions where
        good engineers do their best work — shared patterns, solid platforms, automated quality
        gates, and coaching that raises the bar without taking ownership away.
      </p>
      <p>
        In consultancy, your people and practices are the product. So capability building isn’t
        optional. I’m practical about technology too. Cloud platforms, infrastructure as code,
        observability, and shift-left quality are tools for predictable delivery, not fashion. Same
        with AI-assisted engineering: useful when it speeds up real work, dangerous when it papers
        over weak foundations.
      </p>
    </section>

    <section class="career-block career-block--last" aria-labelledby="career-forward">
      <h2 id="career-forward">Looking Forward</h2>
      <p>
        I want to keep leading public-sector platforms that make complex policy usable for real
        people. And I want to keep investing in the engineering cultures around those services.
        Platform thinking, modern quality practice, and thoughtful use of AI will stay central to
        how I help teams move faster without losing the plot.
      </p>
    </section>
  </section>
</PageLayout>

<style>
  .career {
    max-width: 44rem;
  }

  .career h1 {
    margin-bottom: var(--space-3);
  }

  .career-block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .career-block--last {
    border-bottom: 1px solid var(--color-border);
  }

  .career-block h2 {
    text-transform: none;
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }

  .milestone {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .milestone:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .milestone h3 {
    text-transform: none;
    font-size: 1.2rem;
    margin-bottom: var(--space-2);
  }

  .milestone__meta {
    margin-bottom: var(--space-2);
  }

  .milestone__tech {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .engagements {
    margin-top: var(--space-5);
  }

  .engagements h4 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
    margin-bottom: var(--space-3);
  }

  .engagements__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .engagement__title {
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .engagement__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .engagement__title a:hover {
    color: var(--color-accent);
  }

  .engagement__meta {
    margin-bottom: var(--space-2);
  }
</style>
