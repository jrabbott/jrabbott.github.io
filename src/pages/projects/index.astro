---
import PageLayout from '../../layouts/PageLayout.astro';
import { projects } from '../../data/projects';
---

<PageLayout
  title="Projects · Jon Abbott"
  description="Public-sector services and infrastructure initiatives led from idea to delivery."
>
  <section class="projects">
    <h1>Projects</h1>
    <p class="muted">Services and infrastructure I helped lead as a consultant.</p>

    {
      projects.map((project) => (
        <article class="project" id={project.id}>
          <h2>
            <a href={project.href} target="_blank" rel="noopener noreferrer">
              {project.title}
            </a>
          </h2>
          {'serviceName' in project && project.serviceName && (
            <p class="project__service muted">{project.serviceName}</p>
          )}
          <p class="project__role">{project.role}</p>
          {project.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </article>
      ))
    }
  </section>
</PageLayout>

<style>
  .projects {
    max-width: 44rem;
  }

  .projects h1 {
    margin-bottom: var(--space-3);
  }

  .project {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    /* Breathing room only — header offset lives on html scroll-padding-top. */
    scroll-margin-top: var(--space-4);
  }

  .project:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .project h2 {
    text-transform: none;
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .project h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project h2 a:hover {
    color: var(--color-accent);
  }

  .project__service {
    margin-bottom: var(--space-2);
  }

  .project__role {
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
</style>
