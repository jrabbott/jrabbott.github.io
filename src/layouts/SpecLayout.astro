---
import PageLayout from './PageLayout.astro';
import SpecSidebar from '../components/SpecSidebar.astro';
import { documentTitle } from '../lib/documentTitle';

interface Props {
  title: string;
  description?: string;
  currentId: string;
}

const { title, description, currentId } = Astro.props;
---

<PageLayout title={documentTitle(title)} description={description}>
  <div class="spec-layout">
    <aside class="spec-layout__aside">
      <SpecSidebar currentId={currentId} />
    </aside>
    <div class="spec-layout__content prose">
      <slot />
    </div>
  </div>
</PageLayout>

<style>
  .spec-layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  .spec-layout__aside {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .spec-layout__content h1 {
    text-transform: none;
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (max-width: 800px) {
    .spec-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .spec-layout__aside {
      position: static;
    }
  }
</style>
