---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  image?: string;
  imageAlt?: string;
  pagefindIgnore?: boolean;
}

const { title, description, ogType, image, imageAlt, pagefindIgnore } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogType={ogType}
  image={image}
  imageAlt={imageAlt}
  pagefindIgnore={pagefindIgnore}
>
  <slot name="head" slot="head" />
  <SiteHeader slot="header" />
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
