---
interface Props {
  label: string;
  value: number;
  max?: number;
}

const { label, value, max = 10 } = Astro.props;
const percentage = Math.min(Math.max((value / max) * 100, 0), 100);
---

<div class="metric">
  <div class="metric__header">
    <span class="metric__label">{label}</span>
    <span class="metric__value">{value} / {max}</span>
  </div>
  <div
    class="metric__track"
    role="meter"
    aria-label={label}
    aria-valuenow={value}
    aria-valuemin={0}
    aria-valuemax={max}
  >
    <div class="metric__fill" style={`width: ${percentage}%`}></div>
  </div>
</div>

<style>
  .metric {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }

  .metric__header {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .metric__label {
    font-weight: 600;
    color: var(--color-text);
  }

  .metric__value {
    color: var(--color-accent);
  }

  .metric__track {
    width: 100%;
    height: 8px;
    background-color: var(--color-ground-muted);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .metric__fill {
    height: 100%;
    background-color: var(--color-accent);
    transition: width 0.3s ease;
  }
</style>
