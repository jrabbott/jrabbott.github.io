---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="muted">
      &copy; {year} Jon Abbott ·
      <a href="https://github.com/jrabbott/jrabbott.github.io">Source</a>
      ·
      <a href="https://github.com/jrabbott">GitHub</a>
      ·
      <a href="https://www.linkedin.com/in/jonrabbott/">LinkedIn</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .site-footer__inner {
    width: min(100% - 2rem, var(--page-width));
    margin-inline: auto;
    padding-block: var(--space-5);
  }

  .site-footer a {
    color: var(--color-text-muted);
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }
</style>
