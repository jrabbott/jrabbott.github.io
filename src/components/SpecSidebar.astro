---
import { getCollection } from 'astro:content';
import { buildSpecNav } from '../data/specNav';

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;
const nav = buildSpecNav(await getCollection('spec'));
---

<nav class="spec-sidebar" aria-label="Spec">
  <p class="spec-sidebar__heading">Spec</p>
  <ul class="spec-sidebar__list">
    {
      nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['spec-sidebar__link', { 'is-active': item.id === currentId }]}
            aria-current={item.id === currentId ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<details class="spec-sidebar-mobile">
  <summary>Spec navigation</summary>
  <ul class="spec-sidebar__list">
    {
      nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['spec-sidebar__link', { 'is-active': item.id === currentId }]}
            aria-current={item.id === currentId ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .spec-sidebar__heading {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-size: 0.85rem;
    margin: 0 0 var(--space-3);
  }

  .spec-sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .spec-sidebar__link {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid transparent;
  }

  .spec-sidebar__link:hover {
    color: var(--color-text);
  }

  .spec-sidebar__link.is-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .spec-sidebar-mobile {
    display: none;
    margin-bottom: var(--space-5);
    border: 1px solid var(--color-border);
    padding: var(--space-3);
  }

  .spec-sidebar-mobile summary {
    cursor: pointer;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .spec-sidebar-mobile .spec-sidebar__list {
    margin-top: var(--space-3);
  }

  @media (max-width: 800px) {
    .spec-sidebar {
      display: none;
    }

    .spec-sidebar-mobile {
      display: block;
    }
  }
</style>
