---
const pathname = Astro.url.pathname;

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/spec/', label: 'Spec' },
  { href: '/career/', label: 'Career' },
  { href: '/projects/', label: 'Projects' },
  { href: '/online/', label: 'Online' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">Jon Abbott</a>
    <details class="site-header__menu">
      <summary class="site-header__menu-toggle">Menu</summary>
      <nav class="site-header__nav" aria-label="Primary">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={['site-header__link', { 'is-active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-ground) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    width: min(100% - 2rem, var(--page-width));
    margin-inline: auto;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-header__menu {
    margin-inline-start: auto;
  }

  .site-header__menu-toggle {
    display: none;
  }

  .site-header__nav {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-4);
  }

  .site-header__link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid transparent;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-text);
  }

  .site-header__link.is-active {
    border-bottom-color: var(--color-accent);
  }

  /* Keep primary nav visible on large screens even when details is closed. */
  @media (min-width: 40.01rem) {
    .site-header__nav {
      display: flex;
    }
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--space-4);
    }

    .site-header__brand {
      grid-column: 1;
      grid-row: 1;
      z-index: 1;
    }

    /*
      Details spans the header grid so the open nav can sit in-flow on a full-width
      second row. Empty summary-row space is pointer-events: none so the brand stays
      clickable underneath.
    */
    .site-header__menu {
      grid-column: 1 / -1;
      grid-row: 1 / span 2;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      align-items: center;
      margin-inline-start: 0;
      pointer-events: none;
    }

    .site-header__menu-toggle,
    .site-header__nav {
      pointer-events: auto;
    }

    .site-header__menu-toggle {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      align-items: center;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      padding: var(--space-2) var(--space-3);
    }

    .site-header__menu-toggle::marker {
      content: none;
    }

    .site-header__menu-toggle::-webkit-details-marker {
      display: none;
    }

    .site-header__menu-toggle::after {
      content: '';
      display: inline-block;
      width: 0.4rem;
      height: 0.4rem;
      margin-inline-start: var(--space-2);
      border-inline-end: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-0.1rem) rotate(45deg);
    }

    .site-header__menu[open] .site-header__menu-toggle {
      color: var(--color-text);
    }

    .site-header__menu[open] .site-header__menu-toggle::after {
      transform: translateY(0.15rem) rotate(-135deg);
    }

    .site-header__menu:not([open]) .site-header__nav {
      display: none;
    }

    .site-header__menu[open] .site-header__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--space-1);
      padding-block: var(--space-2) var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .site-header__nav .site-header__link {
      display: block;
      font-size: 1rem;
      padding: var(--space-3) var(--space-2);
      border-bottom: none;
      border-inline-start: 2px solid transparent;
    }

    .site-header__nav .site-header__link.is-active {
      border-inline-start-color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }
  }
</style>
