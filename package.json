{
  "name": "jrabbott.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:md": "markdownlint \"**/*.md\" \"**/*.mdx\" --ignore node_modules --ignore dist --ignore .astro",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Jon Abbott",
  "license": "MIT",
  "description": "Personal site: home, blog, spec, projects.",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "markdownlint-cli": "^0.44.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
