# Run lint-staged
npx lint-staged

# Check if gitleaks is installed on the machine
if command -v gitleaks >/dev/null 2>&1; then
  echo "🔒 Running Gitleaks..."
  gitleaks protect --staged --verbose
else
  echo "⚠️  Gitleaks not found. Skipping secrets scanning."
  echo "👉 Install gitleaks (https://github.com/gitleaks/gitleaks) for local secrets protection."
fi
